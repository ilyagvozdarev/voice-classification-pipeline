# Copy to .env and adjust as needed. `docker compose` reads .env automatically.

LOG_LEVEL=INFO

# --- Models (swap freely; these are small, CPU-friendly defaults) ---
ASR_MODEL_NAME=openai/whisper-tiny
BERT_MODEL_NAME=SamLowe/roberta-base-go_emotions
BERT_THRESHOLD=0.3
LLM_MODEL_NAME=google/flan-t5-small
LLM_MAX_NEW_TOKENS=256

# --- LLM backend & batching ---
# transformers (CPU default) or vllm (via docker-compose.vllm.yml, GPU).
LLM_BACKEND=transformers
LLM_MAX_BATCH_SIZE=8
LLM_BATCH_TIMEOUT_MS=50

# --- Master orchestration ---
REQUEST_TIMEOUT_S=120
